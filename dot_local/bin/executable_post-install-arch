#!/bin/bash

set -ouex pipefail

sudo pacman -Syu
sudo pacman -Sy docker podman podman-compose docker-compose docker-buildx \
       minikube kubectl aws-cli-v2 terraform \
       git cmake cpio meson pkg-config make \
       sudo chrony sof-firmware btrfs-progs dosfstools fuse2 fuse3 ntfs-3g \
       borg borgmatic \
       kitty foot syncthing swww swappy waybar swaync fuzzel adw-gtk-theme gnome-keyring \
       emacs-wayland \
       tree-sitter cloc openai-codex opencode \
       uv typescript typescript-language-server nodejs \
       usbutils dfu-programmer \
       libnotify \
       man-db \
       yt-dlp \
       fish htop btop nvtop eza dust duf procs neovim tmux jq fzf starship fd ripgrep \
       sddm hyprland hypridle hyprlock brightnessctl \
       xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-hyprland \
       vivaldi \
       distrobox flatpak \
       virt-manager dnsmasq vde2 openbsd-netcat \
       snapper snap-pac \
       pipewire wireplumber pipewire-pulse helvum \
       gnome-calculator gnome-calendar gnome-characters gnome-connections gnome-contacts file-roller \
       geary loupe gnome-maps thunar thunar-volman tumbler papers gnome-weather gnome-font-viewer gnome-boxes lollypop \
       telegram-desktop \
       proton-vpn-gtk-app \
       darktable reaper ardour guitarix easyeffects lsp-plugins \
       mpv tigervnc steam

sudo pacman -S --needed base-devel
git clone https://aur.archlinux.org/paru.git
cd paru
makepkg -si
cd ..
rm -rf paru

paru -S wezterm-nightly-bin
paru -S anydesk-bin
paru -S slack-wayland
paru -S proton-pass-bin

sudo systemctl enable sddm.service
        
flatpak override --user --filesystem=~/.themes/
flatpak override --user --filesystem=~/.icons/
flatpak override --user --filesystem=xdg-config/gtk-4.0
flatpak override --user --filesystem=xdg-config/gtk-3.0

~/.local/bin/daily-install

sudo systemctl enable --now libvirtd.service
sudo systemctl enable --now docker.service
sudo systemctl enable --now chrony.service

sudo usermod -aG docker templarrr
sudo usermod -aG games templarrr
sudo usermod -aG audio templarrr
sudo usermod -aG video templarrr
sudo usermod -aG wheel templarrr
sudo usermod -aG libvirt templarrr
sudo usermod -aG libvirt-qemu templarrr

systemctl --user enable syncthing.service
systemctl --user enable pipewire.service
systemctl --user enable wireplumber.service

xdg-mime default app.zen_browser.zen.desktop x-scheme-handler/https
xdg-mime default app.zen_browser.zen.desktop x-scheme-handler/http

git config --global user.email "artyom.smushkov@gmail.com"
git config --global user.name "Artem Smushkov"

sudo snapper -c root create-config /
